{
  "version": 1,
  "pages": [
    {
      "slug": "buchungsanfrage",
      "component": "Buchungsanfrage",
      "title": "Zimmer anfragen",
      "endpoints": [
        {
          "entity": "zimmer",
          "op": "list",
          "fields": [
            "bezeichnung",
            "kategorie",
            "preis_pro_nacht",
            "etage",
            "balkon",
            "foto"
          ],
          "scope_description": "Alle verfügbaren Zimmer",
          "max_records": 100
        },
        {
          "entity": "buchungen",
          "op": "list",
          "fields": [
            "zimmer",
            "anreise",
            "abreise",
            "status"
          ],
          "scope": "r.v_status not in ['storniert', 'angefragt']",
          "scope_description": "Nur bestätigte oder laufende Buchungen (stornierte und angefragte gelten als frei)",
          "max_records": 500
        },
        {
          "entity": "gaeste",
          "op": "create",
          "fields": [
            "vorname",
            "nachname",
            "email",
            "telefon"
          ]
        },
        {
          "entity": "buchungen",
          "op": "create",
          "fields": [
            "gast",
            "zimmer",
            "anreise",
            "abreise",
            "personen",
            "bemerkung"
          ],
          "preset_fields": {
            "status": "angefragt"
          }
        }
      ]
    }
  ]
}