{
  "version": 1,
  "pages": [
    {
      "slug": "buchungsanfrage",
      "component": "Buchungsanfrage",
      "title": "Zimmer anfragen",
      "endpoints": [
        {
          "entity": "buchungen",
          "op": "list",
          "fields": [
            "anreise",
            "abreise",
            "zimmer",
            "status"
          ],
          "scope": "r.v_status not in ('storniert', 'angefragt')",
          "scope_description": "Zeigt nur aktive Buchungen (bestätigt, eingecheckt, ausgecheckt) für die Belegungsanzeige — stornierte und offene Anfragen werden nicht als belegt gewertet",
          "max_records": 500
        },
        {
          "entity": "zimmer",
          "op": "list",
          "fields": [
            "bezeichnung",
            "kategorie",
            "preis_pro_nacht"
          ],
          "scope_description": "Alle Zimmer mit Bezeichnung, Kategorie und Preis pro Nacht für die Zimmerauswahl",
          "max_records": 200
        },
        {
          "entity": "gaeste",
          "op": "create",
          "fields": [
            "vorname",
            "nachname",
            "email",
            "telefon"
          ]
        },
        {
          "entity": "buchungen",
          "op": "create",
          "fields": [
            "gast",
            "zimmer",
            "anreise",
            "abreise",
            "personen",
            "bemerkung"
          ],
          "preset_fields": {
            "status": "angefragt"
          }
        }
      ]
    }
  ]
}